<key>UILaunchScreen</key><dict><key>UIColorName</key><string>LaunchBackground</string></dict><key>UIBackgroundModes</key><array><string>audio</string></array>
<key>NSAppTransportSecurity</key>
<dict>
    <key>NSExceptionDomains</key>
